<!-- @author Lorenzo -->
@page "/register"
<!--This page is rendered via the browser for the purpose of encrypting the user's password prior to submission. The backend server will at no point receive the user's true password credential-->
@rendermode @(new InteractiveWebAssemblyRenderMode( 
                prerender: false)) 
@using System.Net
@using System.Security.Cryptography
@using System.Text
<!--TopSecret package used for Argon2 cryptographic operations in browser assembly-->
@using TopSecret.Cryptography 
@using SecureVotingApp.Components.Contracts
@using SecureVotingApp.Client.Contracts.AccountContracts
<!--QRCoder package used for generating QR code using TOTP URI from backend API-->
@using QRCoder
@inject HttpClient Http
@inject NavigationManager Navigation
<h3>Create Account</h3>

<!--Edit Form used to bind RegisterRequest model to form details. Check RegisterRequest for property specific data anotations-->
<EditForm Model="_request" FormName="AccountRegistration" OnValidSubmit="RegisterAsync">
    <label>Email</label><br/>
    <InputText @bind-Value="_request.Email"/><br/>

    <label>Password</label><br/>
    <InputText type="password" @bind-Value="_request.Password"/><br/>
    <label>Confirm Password</label><br/>
    <InputText type="password" @bind-Value="_request.ConfirmPassword"/><br/><br/>
    <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">Create Account</button>
    @if (_message is not null)
    {
        <p role="status">@_message</p>
    }
    <DataAnnotationsValidator/>
    <ValidationSummary/>
</EditForm>


<!--
    Once the account creation is registered a 2FA QR generated to confirm account creation
    Modal is used to display the QR code and provides step-by-step instructions on how to set up 2FA on the user's mobile device
    Using Bootstrap modal to display QR code and 2FA instructions.
-->
@if (_confirmRegistration)
{
    <EditForm Model="_confirmRequest" FormName="ConfirmRegistration" OnValidSubmit="ConfirmRegistration">
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseConfirmRegistrationModal"></button>
                    <div class="modal-header text-center">
                        <h5 class="modal-title">Set up Two-Factor Authentication</h5>
                    </div>

                    <div class="modal-body text-center">
                        <img src="@_qrImage" alt="2FA QR Code" width="250" height="250"/><br/><br/>
                        <label>2FA Code:</label><br/>
                        <InputText @bind-Value="_confirmRequest.Code" maxlength="6" minlength="6"/><br/><br/>
                        <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">Confirm Registration</button><br/>
                    </div>
                    @if (_confirmMessage is not null)
                    {
                        <p role="status">@_confirmMessage</p>
                    }
                    <div class="modal-body">

                        <p>In-order to complete registration, it is required that your account has two-factor authentication enabled.</p>
                        <ol>
                            <li>Install Authenticator Service on your mobile device - Recommended 2FA App:<br/> <a href="https://play.google.com/store/apps/details?id=com.azure.authenticator&hl=en&pli=1" target="_blank">Android - Microsoft Authenticator</a><br/><a href="https://apps.apple.com/us/app/microsoft-authenticator/id983156458" target="_blank">Apple - Microsoft Authenticator</a></li>
                            <li>Open the app and select the option to add a new account</li>
                            <li>Choose "Scan a QR code" and use your phone's camera to scan the QR code displayed above</li>
                            <li>Enter the 6-digit code generated by your authenticator app into the field above</li>
                            <li>Select the "Confirm Registration" button to confirm your setup</li>
                        </ol>
                        <p>Authenticator app will generate a new code every 30 seconds. Please enter the currently displayed code whenever you sign in.</p>
                        <p role="alertdialog"><b>Important:</b> never share your authentication code with anyone.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <DataAnnotationsValidator/>
        <ValidationSummary/>
    </EditForm>
}


@if (_registrationComplete) // on confirmation of registration via 2FA code, modal displays informing the user that their account has been successfully created
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">

                <div class="modal-header">
                    <h5 class="modal-title">Registration Complete</h5>
                </div>

                <div class="modal-body">
                    <p>Your account has been created successfully.</p>
                    <p>Please log in to continue.</p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn btn-primary"
                            @onclick="GoToLogin">
                        Login Page
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private readonly RegisterRequest _request = new(); // Initial registration request object
    private string? _message;
    private string? _confirmMessage;
    private bool _isSubmitting; // if this value is true - the submit button is disabled
    private bool _confirmRegistration;
    private ConfirmRegistrationRequest _confirmRequest = new(); // Confirmation registration request object - requires 2FA
    private string _qrImage = string.Empty;
    private bool _registrationComplete; // Flag for final confirmation modal
    
    public async Task RegisterAsync()
    {
        _confirmRegistration = false;
        _isSubmitting = true;
        _message = null;
        
        // Generating the hashed password
        var salt = RandomNumberGenerator.GetBytes(16);
        var passwordBytes = Encoding.UTF8.GetBytes(_request.Password);
        
        // Argon2 Settings with randomly generated Salt
        // Salt needs to be saved and associated to it's given user for future Login attempt password hashing
        using var argon2 = new Argon2id(passwordBytes)
        {
            Salt = salt,
            DegreeOfParallelism = 1,
            MemorySize = 19456,
            Iterations = 1
        };

        var hash = await argon2.GetBytesAsync(32);

        // this value will eventually be stored in the database and used for credential validation during future login attempts
        var argon2Hash = Convert.ToBase64String(hash);

        var payload = new UserRegistration()
        {
            Email = _request.Email,
            Argon2Hash = argon2Hash,
            Argon2Salt = Convert.ToBase64String(salt)
        };
        
        
        // API Registration Request - backend returns a TOTP setup URI and Registration ID used for confirmation of registration via 2FA code
        using var response = await Http.PostAsJsonAsync(
            "api/auth/register",
            payload);
        
        // Successful initial registration - Generate QR Code for 2FA
        if (response.IsSuccessStatusCode)
        {
            var totpDetails = await response.Content.ReadFromJsonAsync<TotpDetails>();
            // Server error check - TOTP must exist
            if (totpDetails is null)
            {
                _message = "Service Error: Please try again later.";
                _isSubmitting = true;
                return;
            }
            
            // Extract Registration ID for future confirmation registration request
            _confirmRequest.RegistrationId = totpDetails.RegistrationID;
            GenerateQrCode(totpDetails.SetupURI);
            _confirmRegistration = true;
        }
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later";
        }
        else if (response.StatusCode is HttpStatusCode.BadRequest or  HttpStatusCode.Conflict)
        {
            _message = await response.Content.ReadAsStringAsync();
        }
        else
        {
            _message = "Service Error: Please try again later.";
        }
        
        // Clears cryptographic operation buffer to remove password bytes from memory - replaced by zeroes
        CryptographicOperations.ZeroMemory(passwordBytes);
        
        _isSubmitting = false;
    }

    private void GenerateQrCode(string setupUri)
    {
        // QRCoder library used to generate QR code image for 2FA setup
        // QR code is displayed in a modal dialog when user submits initial registration account details
        byte[] qrBytes = PngByteQRCodeHelper.GetQRCode(
            setupUri,
            QRCodeGenerator.ECCLevel.Q, // ECC Level Q allows for moderate error correction in QR code - only 25% of the qrcode is needed for mobile cameras to decode 
            10);
        // In-memory PNG that is presented to user in 2FA modal
        _qrImage = $"data:image/png;base64,{Convert.ToBase64String(qrBytes)}";
    }
    
    // Final confirmation of registration given during 2FA setup
    public async Task ConfirmRegistration()
    {
        _isSubmitting = true;
        ConfirmRegistrationRequest confirmRegistrationPayload = new()
        {
            RegistrationId = _confirmRequest.RegistrationId,
            Code = _confirmRequest.Code
        };

        using var response = await Http.PostAsJsonAsync(
            "api/auth/confirm-registration",
            confirmRegistrationPayload);

        if (response.IsSuccessStatusCode)
        {
            _confirmRegistration = false;
            _registrationComplete = true;
        }
        else if (response.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Unauthorized or HttpStatusCode.Conflict)
        {
            _confirmMessage = await response.Content.ReadAsStringAsync();
        }
        else
        {
            _confirmMessage = "Service Error: Please try again later.";
        }

        _isSubmitting = false;
    }

    private void CloseConfirmRegistrationModal()
    {
        _confirmRegistration = false;
    }
    
    // Registration complete button calls this method to redirect user to login page
    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}