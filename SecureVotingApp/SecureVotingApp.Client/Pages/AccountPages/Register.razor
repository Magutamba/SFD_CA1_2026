<!-- @author Lorenzo -->
@page "/register"
@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@using System.Net
@using System.Security.Cryptography
@using System.Text
@using TopSecret.Cryptography
@using SecureVotingApp.Components.Contracts
@using SecureVotingApp.Client.Contracts.AccountContracts
@inject HttpClient Http
@inject NavigationManager Navigation
<h3>Create Account</h3>

<!--Edit Form used to bind RegisterRequest model to form details. Check RegisterRequest for property specific data anotations-->
<EditForm Model="_request" FormName="AccountRegistration" OnValidSubmit="RegisterAsync">
    <label>Email</label><br/>
    <InputText @bind-Value="_request.Email"/><br/>
    
    <label>Password</label><br/>
    <InputText type="password" @bind-Value="_request.Password"/><br/>
    <label>Confirm Password</label><br/>
    <InputText type="password" @bind-Value="_request.ConfirmPassword"/><br/>
    <button type="submit" disabled="@_isSubmitting">Create Account</button>
    
    <DataAnnotationsValidator/>
    <ValidationSummary/>
</EditForm>

@if (_message is not null)
{
    <p role="status">@_message</p>
}

@if (_confirmRegistration)
{
    <EditForm Model="_confirmRequest" FormName="ConfirmRegistration" OnValidSubmit="">
        <!--QR Code Information-->
        <!--Steps to get it ready-->
        <label>2FA Code:</label><br/>
        <InputText @bind-Value="_confirmRequest.Code"/><br/>
        
        <button type="submit" disabled="@_isSubmitting">Confirm Registration</button>
        
        <DataAnnotationsValidator/>
        <ValidationSummary/>
    </EditForm>
}



@code {
    private readonly RegisterRequest _request = new();
    private string? _message;
    private bool _isSubmitting; // if this value is true - the submit button is disabled
    private bool _confirmRegistration;
    private ConfirmRegistrationRequest _confirmRequest = new();
    
    public async Task RegisterAsync()
    {
        _isSubmitting = true;
        _message = null;
        
        // Generating the hashed password
        var salt = RandomNumberGenerator.GetBytes(16);
        var passwordBytes = Encoding.UTF8.GetBytes(_request.Password);
        
        // Argon2 Settings with randomly generated Salt
        // Salt needs to be saved and associated to it's given user for future Login attempt password hashing
        using var argon2 = new Argon2id(passwordBytes)
        {
            Salt = salt,
            DegreeOfParallelism = 1,
            MemorySize = 19456,
            Iterations = 1
        };

        var hash = await argon2.GetBytesAsync(32);

        var argon2Hash = Convert.ToBase64String(hash);

        var payload = new UserRegistration()
        {
            Email = _request.Email,
            Argon2Hash = argon2Hash,
            Argon2Salt = Convert.ToBase64String(salt)
        };
        
        
        // API Request
        using var response = await Http.PostAsJsonAsync(
            "api/auth/register",
            payload);

        if (response.IsSuccessStatusCode)
        {
            var totpDetails = await response.Content.ReadFromJsonAsync<TotpDetails>();
            if (totpDetails is null)
            {
                _message = "Service Error: Please try again later.";
                _isSubmitting = true;
                return;
            }

            _confirmRegistration = true;
            
            await Login(argon2Hash);
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later";
        }
        else if (response.StatusCode is HttpStatusCode.BadRequest or  HttpStatusCode.Conflict)
        {
            _message = await response.Content.ReadAsStringAsync();
        }
        else
        {
            _message = "Service Error: Please try again later.";
        }
        
        CryptographicOperations.ZeroMemory(passwordBytes);
        
        _isSubmitting = false;
    }

    private async Task ConfirmRegistration()
    {
        
    }

    private async Task Login(string argon2Hash)
    {
        var userPayload = new UserLogin()
        {
            Email = _request.Email,
            Argon2Hash = argon2Hash
        };
        
        using var response = await Http.PostAsJsonAsync(
            "api/auth/login",
            userPayload);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/account", forceLoad: true);
        }
        else if (response.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Unauthorized)
        {
            _message = await response.Content.ReadAsStringAsync();
        }
        else
        {
            _message = "Service Error: Please try again later.";
        }
        
    }
}