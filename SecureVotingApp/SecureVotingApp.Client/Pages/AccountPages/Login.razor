<!-- @author Lorenzo -->
@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@using System.Net
@using System.Text
@using TopSecret.Cryptography
@using SecureVotingApp.Components.Contracts
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Login Account</h3>

<!--Edit Form used to bind LoginRequest model to form details. Check LoginRequest for property specific data anotations-->
<EditForm Model="_request" FormName="AccountLogin" OnValidSubmit="LoginAsync">
    <label>Email</label><br/>
    <InputText @bind-Value="_request.Email"/><br/>
    
    <label>Password</label><br/>
    <InputText type="password" @bind-Value="_request.Password"/><br/>
    <label>2FA Code</label><br/>
    <InputText type="password" @bind-Value="_request.Code"/><br/>
    <button type="submit" disabled="@_isSubmitting">Login</button>
    
    <DataAnnotationsValidator/>
    <ValidationSummary/>
</EditForm>

@if (_message is not null)
{
    <p role="status">@_message</p>
}


@code {
    private readonly LoginRequest _request = new();
    private string? _message;
    private bool _isSubmitting; // if this value is true - the submit button is disabled
    
    public async Task LoginAsync()
    {
        _isSubmitting = true;
        _message = null;

        string savedSalt = await GetSalt();
        
        if (string.IsNullOrWhiteSpace(savedSalt))
        {
            _message += "Error retrieving account details, please contact support. ";
            _isSubmitting = false;
            return;
        }
        
        byte[] salt = Convert.FromBase64String(savedSalt);
        var passwordBytes = Encoding.UTF8.GetBytes(_request.Password);
        // Argon2 Settings with saved salt
        using var argon2 = new Argon2id(passwordBytes)
        {
            Salt = salt,
            DegreeOfParallelism = 1,
            MemorySize = 19456,
            Iterations = 1
        };
        var hash = await argon2.GetBytesAsync(32);
        var argon2Hash  = Convert.ToBase64String(hash);
        
        // API Request
        var userPayload = new UserLogin()
        {
            Email = _request.Email,
            Argon2Hash = argon2Hash,
            Code = _request.Code
        };
        
        using var response = await Http.PostAsJsonAsync(
            "api/auth/login",
            userPayload);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/account", forceLoad: true);
        } 
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later";
        }
        else
        {
            _message = "Invalid credentials. Please try again";
        }
        
        _isSubmitting = false;
    }
    
    // Retrieve user's saved salt value to ensure password encryption returns the same hash
    private async Task<string> GetSalt()
    {
        var saltPayload = new SaltRequest()
        {
            Email = _request.Email
        };
        
        // API call using email to get account salt
        using var saltResponse = await Http.PostAsJsonAsync(
            "api/auth/details",
            saltPayload);
        
        if (saltResponse.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later. ";
            return "";
        }
        if (!saltResponse.IsSuccessStatusCode)
        {
            _message = $"Error retrieving details: {await saltResponse.Content.ReadAsStringAsync()}. ";
            return "";
        }
        
        
        var saltResult = await saltResponse.Content.ReadFromJsonAsync<SaltResponse>();

        return saltResult?.Salt ?? string.Empty;
    }
    
}