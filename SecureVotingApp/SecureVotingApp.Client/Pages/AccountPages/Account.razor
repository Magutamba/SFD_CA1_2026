@page "/account"

@using System.Net
@using Microsoft.AspNetCore.Components.Authorization

@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@inject HttpClient Http
@inject NavigationManager Navigation
<h3>Account</h3>
<AuthorizeView>
    <Authorized>
        
        <p>Logged into system. Please click the following link to cast your ballot.</p>

        <NavLink class="nav-link" href="vote" style ="color:blue">
            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Vote Link
        </NavLink>
        <br/>
        <button type="submit" @onclick="@Logout">Logout</button>
        <p role="status">@_message</p>
    </Authorized>
    <NotAuthorized>
        <p>Login or Register</p>
        <NavLink class="nav-link" href="login" style="color:blue">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <u>Login Link</u>
        </NavLink>
        
        <NavLink class="nav-link" href="register" style="color:blue">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <u>Register Link</u>
        </NavLink>
    </NotAuthorized>
</AuthorizeView>
    
@code {
    private string? _message = null;
    private async void Logout()
    {
        using var response = await Http.PostAsync(
            "api/auth/logout",
            content: null);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later";
        }
    }
}