@page "/vote/{ElectionId}"
<!-- @author Moïse *-->

<!--et the Contracts and Services*-->
@using SecureVotingApp.Components.Contracts
@using SecureVotingApp.Components.Services

@inject VoterApiClient VoterApiClient

<PageTitle>Vote</PageTitle>


<div class="container mt-4"></div>
        <p>
            <strong>Election Id</strong> @ElectionId
        </p>

        <!-- Display the election the voter is participating in -->

        <!--show the credential request button before session starts --->

        @if(votingSession == null)
        {
            <!-- request credentials before allowing vote -->
            <p>Request Credentials to vote</p>
            <button class="btn btn-primary"
                    @onClick={RequestCredentials}
                    disabled="@isLoading">
                    @(isLoading ? "Requesting credentials..." : "Request Credentials")
            </button>
        }
        else if( receipt == null)
        {
            <hr />
            <h3> Voting Credential Issued</h3>
            <p> Your credential as been issued.</p>

            <!-- display credential expiry time-->
            <p>
                <strong> Credential Expiry:</strong>@votingSession.ExpireAt.ToLocalTime().ToString("H:mm")
            </p>
        }

        <div>
            <button class="btn btn-primary" @onClick={RequestCredentials}>Request Credentials</button>
        </div><!-- show the voting form after session
        @if(votingSession!=null && receipt == null)
        {
            <hr />
            <h3> Voting Credential Issued</h3>
            <p> Your credential as been issued.</p>

            <!-- display credential expiry time-->
            <p>
                <strong> Credential Expiry:</strong>@votingSession.ExpireAt.ToLocalTime()
            </p>

            <h3> Cast your ballot</h3>

            <div class="form-group">
                <label for="voteChoice">Enter your choice:</label>
                <input 
                    id="voteChoice"
                    type="text"
                    @bind="voteChoice"
                    placeholder="Enter yes, no, anything else will be considered as a spoiled ballot"
                />

            </div>

            <!-- submite anonymous credential and vote -->
            <button class="btn btn-success"
                    @onClick={SubmitVote}
                    disabled="@isLoading">
                    @(isLoading ? "Submitting vote..." : "Submit Vote")
            </button>

        }

        <!-- display vote receipt for successful submission -->
        @if (receipt !=null)
        {
            
        }

</div>
@code {
    private async Task RequestCredentials()
    {
        
    }
}