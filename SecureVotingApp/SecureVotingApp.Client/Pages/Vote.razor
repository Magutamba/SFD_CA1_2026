<!-- @author Moïse *-->
<!--***-->
@page "/vote"
@*@page "vote/{electionId}"*@

@* run the page in browser*@
@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@inject HttpClient Http
@inject NavigationManager Navigation
<!--get the Contracts and Services*-->
@using SecureVotingApp.Client.Contracts
@using SecureVotingApp.Client.Services

@*inject the VoterAPIClient to handle voter API endpoints for requesting credentials and ballots*@
@inject VoterApiClient VoterApiClient


<PageTitle>Vote</PageTitle>


<div class="container mt-4">
        <p>
            <!--*** display the election id  if available -->
            <strong>Election Id</strong> @(voteSession?.ElectionId ?? "election-2026")
        </p>

        <!-- Display the election the voter is participating in -->

        <!--show the credential request button before session starts --->

        @if(voteSession == null && receipt ==null)
        {
            <!-- request credentials before allowing vote -->
            <p>Request Credentials to vote</p>
            <button class="btn btn-primary"
                    @onclick="RequestCredentials"
                    disabled="@isLoading">
                    @(isLoading ? "Requesting credentials..." : "Request Credentials")
            </button>
        }
        else if(voteSession != null && receipt == null)
        {
            <hr />
            <h3> Voting Credential Issued</h3>
            <p> Your credential as been issued.</p>

            <!-- display credential expiry time-->
            <p>
                <strong> Credential Expiry:</strong>@voteSession.CredentialExpiresAt.ToLocalTime().ToString("H:mm")
            </p>

            <h3> Cast your ballot</h3>
            <!--isLoading prevents change to vote while submitting-->
            <div class="form-group">
                <label for="voteChoice">Enter your choice:</label>
                <input 
                    id="voteChoice"
                    type="text"
                    @bind="voteChoice"
                    placeholder="Enter yes or no, anything else will be considered as a spoiled ballot"
                    disabled="@isLoading"
                />

            </div>

            <!-- submite anonymous credential and vote -->
            <button class="btn btn-success"
                    @onclick="SubmitVote" 
                    disabled="@isLoading">
                    @(isLoading ? "Submitting vote..." : "Submit Vote")
            </button>

        }

        <!-- display vote receipt for successful submission -->
        @if (receipt !=null)
        {
            <hr />
            <h3>Vote Submitted</h3>
            <p>@receipt.ConfirmationMessage</p>

            <p>
                <strong>Receipt ID: </strong>@receipt.ReceiptId
            </p>
            <p class="text-success">
                Your vote has been successfully submitted and recorded. You cannot request another credential or vote again.

            </p>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                    @errorMessage
            </div>
            
        }

</div>

@code{

    //anonymous anonymous credential in memory
    private VoteSession? voteSession;

    //store the receipt returned from the server after submission
    private VoteReceipt? receipt;
    //store user vote
    private string voteChoice = string.Empty;

    //restore existing credential and receipt from browser session
    //VoterApiClient will handle the session storage 
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            //restore previously save vote session
            voteSession = await VoterApiClient.GetSavedVoteSessionAsync();
            receipt = await VoterApiClient.GetSavedVoteReceiptAsync();

        }catch(Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    //control loading state for async operations
    private bool isLoading =false;

    //store error message for display
    private string errorMessage = string.Empty;

    //request and receive anonymous signed voting credentials 
    private async Task RequestCredentials()
    {
        if (isLoading || voteSession != null || receipt !=null)
            return;
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
           
                //VoterApiClient retrieves the blinded credential from the server, credential session storage
                voteSession = await VoterApiClient.RequestBallotAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;

        }finally
        {
            isLoading = false;
        }
    }

    //submit anonymous credential and vote to the server
    private async Task SubmitVote()
    {
        //ensure  credential, vote is present exist before submission
        if(isLoading || voteSession == null || receipt != null ||string.IsNullOrWhiteSpace(voteChoice))
            return;
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            //call api client to submit the vote
            receipt = await VoterApiClient.SubmitVoteAsync(voteSession, voteChoice.Trim());

            //clear credential from component memory
            voteSession = null;

            //clear the vote choice after submission
            voteChoice = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage =ex.Message; 

        }finally
        {
            isLoading = false;
        }
    }
}