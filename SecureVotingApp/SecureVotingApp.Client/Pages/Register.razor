@page "/register"
@using Microsoft.AspNetCore.Components.Web
@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@using System.Security.Cryptography
@using System.Text
@using TopSecret.Cryptography
@using SecureVotingApp.Components.Contracts

<h3>Create Account</h3>

<p>Button: @count times</p>
<button @onclick="upCount">test me</button>

<p>Renderer: @RendererInfo.Name</p>
<p>Interactive: @RendererInfo.IsInteractive</p>

<EditForm Model="_request" FormName="AccountRegistration" OnValidSubmit="RegisterAsync">
    <label>Email</label>
    <InputText @bind-Value="_request.Email"/>
    
    <label>Password</label>
    <InputText type="password" @bind-Value="_request.Password"/>
    <button type="submit" disabled="@_isSubmitting">Create Account</button>
    
    <DataAnnotationsValidator/>
    <ValidationSummary/>
</EditForm>

@if (_message is not null)
{
    <p role="status">@_message</p>
    <p>Original Password: @_request.Password</p>
    <p>Hashed Password: @_hashedPw</p>
    <p>Salt Used: @Convert.ToBase64String(_salt)</p>
}

@code {
    private readonly RegisterRequest _request = new();
    private string? _message;
    private bool _isSubmitting; // if this value is true - the submit button is disabled
    private string _hashedPw = string.Empty;
    private byte[] _hash = [];
    private byte[] _salt = [];
    public int count = 0;
    public void upCount()
    {
        count++;
    }
    
    public async Task RegisterAsync()
    {
        _isSubmitting = true;
        _message = null;
        
        // Generating the hashed password
        _salt = RandomNumberGenerator.GetBytes(16);
        var passwordBytes = Encoding.UTF8.GetBytes(_request.Password);
        
        // Argon2 Settings with randomly generated Salt
        // Salt needs to be saved and associated to it's given user for future Login attempt password hashing
        using var argon2 = new Argon2id(passwordBytes)
        {
            Salt = _salt,
            DegreeOfParallelism = 1,
            MemorySize = 19456,
            Iterations = 1
        };

        _hash = await argon2.GetBytesAsync(32);

        _hashedPw = Convert.ToBase64String(_hash);
        // API Request
        // await API.Request(request.Email, _hashedPw, salt)
        // Simulating valid request
        _message = "Account created successfully";

        _isSubmitting = false;
    }
}