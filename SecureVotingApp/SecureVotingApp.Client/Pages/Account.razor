@page "/account"

@using System.Net
@using Microsoft.AspNetCore.Components.Authorization

@rendermode @(new InteractiveWebAssemblyRenderMode(
                prerender: false))
@inject HttpClient Http
@inject NavigationManager Navigation
<h3>Account</h3>
<AuthorizeView>
    <Authorized>
        <p>Logged into system. Welcome</p>
        <button type="submit" @onclick="@Logout">Logout</button>
        <p role="status">@_message</p>
    </Authorized>
    <NotAuthorized>
        <NavLink class="nav-link" href="login">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Login Link
        </NavLink>

        <NavLink class="nav-link" href="register">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Register Link
        </NavLink>
    </NotAuthorized>
</AuthorizeView>
    
@code {
    private string? _message = null;
    private async void Logout()
    {
        using var response = await Http.PostAsync(
            "api/auth/logout",
            content: null);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (response.StatusCode == HttpStatusCode.TooManyRequests)
        {
            _message = "Too many requests. Please try again later";
        }
    }
}